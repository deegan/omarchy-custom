# Maintainer: Hakan Bjorklund <hakan.bjorklund@gmail.com>
# Unofficial local build, sourced directly from upstream (not the AUR).
# Upstream: https://github.com/Ratpido-dev/cairn
# Derived from upstream's own packaging/aur/PKGBUILD (which lags at 1.0.3).

pkgname=cairn-tracker
pkgver=1.0.4
pkgrel=1
pkgdesc="Native Linux Hearthstone tracker: reads the game's own logs, no Wine, no injection"
arch=('any')
url="https://github.com/Ratpido-dev/cairn"
license=('MIT')
depends=('python' 'pyside6' 'qt6-svg')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('kwin: window rules that keep the overlays above a fullscreen game')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f15509c56622926b0f0fcf5651e984ad2853c44c026485e9011ab03b7d6000db')

build() {
  cd "cairn-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "cairn-$pkgver"
  QT_QPA_PLATFORM=offscreen python -m pytest
}

package() {
  cd "cairn-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm755 tools/install_kwin_rule.sh \
    "$pkgdir/usr/share/cairn/install_kwin_rule.sh"

  install -Dm644 packaging/cairn.desktop \
    "$pkgdir/usr/share/applications/cairn.desktop"
  install -Dm644 packaging/cairn.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/cairn.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
