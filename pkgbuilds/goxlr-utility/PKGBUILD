# Maintainer: Hakan Bjorklund <hakan.bjorklund@gmail.com>
# Unofficial local build, sourced directly from upstream (not the AUR).
# Upstream: https://github.com/GoXLR-on-Linux/goxlr-utility

pkgname=goxlr-utility
pkgver=1.2.4
pkgrel=1
pkgdesc="Unofficial utility for monitoring and controlling a TC-Helicon GoXLR or GoXLR Mini"
arch=('x86_64' 'aarch64')
url="https://github.com/GoXLR-on-Linux/goxlr-utility"
license=('MIT')
depends=('libusb' 'libpulse' 'openssl')
makedepends=('cargo' 'pkgconf' 'openssl')
source=("$pkgname-$pkgver.tar.gz::https://github.com/GoXLR-on-Linux/goxlr-utility/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8fc57e3ab2a5f103cb5a4aff6b42537386012d5f35598d9e1b787b7753fc28bb')
install=goxlr-utility.install

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target

  # goxlr-daemon pulls in reqwest's "rustls-tls" feature purely for its
  # firmware-update HTTPS check. rustls' "ring" backend fails to link on this
  # toolchain (cargo drops the link-search path for ring's build-script
  # output when it's built twice in the unit graph, leaving undefined
  # ring_core_* symbols at link time). Switch that one feature to native-tls
  # (system OpenSSL) instead, which sidesteps ring entirely.
  sed -i 's/features = \["stream", "rustls-tls"\]/features = ["stream", "native-tls"]/' daemon/Cargo.toml

  cargo build --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/goxlr-daemon "$pkgdir/usr/bin/goxlr-daemon"
  install -Dm755 target/release/goxlr-client "$pkgdir/usr/bin/goxlr-client"
  install -Dm755 target/release/goxlr-launcher "$pkgdir/usr/bin/goxlr-launcher"
  install -Dm755 target/release/goxlr-defaults "$pkgdir/usr/bin/goxlr-defaults"

  install -Dm644 50-goxlr.rules "$pkgdir/usr/lib/udev/rules.d/50-goxlr.rules"

  install -Dm644 daemon/resources/goxlr-utility.desktop \
    "$pkgdir/usr/share/applications/goxlr-utility.desktop"
  install -Dm644 daemon/resources/goxlr-utility.png \
    "$pkgdir/usr/share/icons/hicolor/48x48/apps/goxlr-utility.png"
  install -Dm644 daemon/resources/goxlr-utility.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/goxlr-utility.svg"
  install -Dm644 daemon/resources/goxlr-utility-large.png \
    "$pkgdir/usr/share/pixmaps/goxlr-utility.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Shell completions generated by build.rs into OUT_DIR
  local daemon_out client_out
  daemon_out="$(dirname "$(find target/release/build -path '*/out/daemon-stamp' | head -n1)")"
  client_out="$(dirname "$(find target/release/build -path '*/out/client-stamp' | head -n1)")"

  if [ -n "$daemon_out" ]; then
    install -Dm644 "$daemon_out/goxlr-daemon.bash" "$pkgdir/usr/share/bash-completion/completions/goxlr-daemon"
    install -Dm644 "$daemon_out/goxlr-daemon.fish" "$pkgdir/usr/share/fish/vendor_completions.d/goxlr-daemon.fish"
    install -Dm644 "$daemon_out/_goxlr-daemon" "$pkgdir/usr/share/zsh/site-functions/_goxlr-daemon"
  fi
  if [ -n "$client_out" ]; then
    install -Dm644 "$client_out/goxlr-client.bash" "$pkgdir/usr/share/bash-completion/completions/goxlr-client"
    install -Dm644 "$client_out/goxlr-client.fish" "$pkgdir/usr/share/fish/vendor_completions.d/goxlr-client.fish"
    install -Dm644 "$client_out/_goxlr-client" "$pkgdir/usr/share/zsh/site-functions/_goxlr-client"
  fi
}
